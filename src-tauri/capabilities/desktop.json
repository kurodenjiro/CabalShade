{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Main window on desktop. core:default already bundles app/event/image/menu/path/resources/tray/webview/window, so listing its members alongside it would be redundant rather than least privilege. App command permissions are generated from the COMMANDS list in build.rs \u2014 see capabilities/README.md.",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-send-intent-to-mesh",
    "allow-get-relay-stats",
    "allow-record-relay-bytes",
    "allow-kill-switch",
    "allow-enable-instant-session",
    "allow-sync-blockchain-state",
    "allow-get-bridge-status",
    "allow-check-rpc-reachable",
    "allow-get-identity",
    "allow-get-primary-private-key",
    "allow-logout-wallet",
    "allow-import-wallet",
    "allow-get-wallet-snapshot",
    "allow-delete-wallet-snapshot",
    "allow-create-escrow",
    "allow-release-escrow",
    "allow-refund-escrow",
    "allow-get-escrow-status",
    "allow-release-deal",
    "allow-refund-deal",
    "allow-get-my-deals",
    "allow-mint-voucher",
    "allow-approve-voucher",
    "allow-redeem-voucher",
    "allow-get-voucher-owner",
    "allow-get-owned-vouchers",
    "allow-create-asset-listing",
    "allow-get-active-asset-listings",
    "allow-buy-listing",
    "allow-submit-raw-transaction",
    "allow-get-pending-relay-txs",
    "allow-prune-stale-relay-txs",
    "allow-mark-relay-tx-status",
    "allow-record-relayed-tx",
    "allow-get-relayed-history",
    "allow-get-relay-boost",
    "allow-apply-relay-boost",
    "allow-sign-content",
    "allow-store-content",
    "allow-get-content",
    "allow-receive-content",
    "allow-get-received-content",
    "allow-extract-pdf-text",
    "allow-analyze-pdf-content",
    "allow-get-ollama-status",
    "allow-get-ollama-url",
    "allow-set-ollama-url",
    "allow-can-spawn-processes",
    "allow-match-intent-to-listings",
    "allow-generate-zk-proof",
    "allow-unsubscribe",
