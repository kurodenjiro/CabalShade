<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merged with Tauri's generated Info.plist via bundle.iOS.infoPlist.

  Lives here rather than in gen/apple/ because that tree is regenerated by
  `tauri ios init`, which would silently drop these keys — and their absence
  does not error, it just makes peer discovery return nothing.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Required since iOS 14 for any multicast or local-network traffic.

      Without this key AND NSBonjourServices below, iOS silently drops mDNS
      packets. It does not error, it does not prompt, and discovery simply
      returns zero peers — which is a genuinely nasty thing to debug on a
      device, because every other part of the mesh looks healthy.

      The wording follows the brand's voice: impersonal, present tense, stating
      a protocol fact rather than asking a favour.
    -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>CabalMesh discovers nearby nodes on your local network. No identity is attached.</string>

    <!--
      The service types libp2p's mDNS behaviour advertises and browses. iOS
      only permits the ones declared here, so a mismatch has the same silent
      effect as omitting the usage description.
    -->
    <key>NSBonjourServices</key>
    <array>
        <string>_p2p._udp</string>
        <string>_p2p._tcp</string>
    </array>

    <!--
      Export compliance is deliberately NOT declared here.

      This app ships AES-256-GCM at rest and Noise in transit, but that does
      not automatically make the encryption non-exempt — most apps using
      standard cryptography for standard purposes qualify for an exemption, and
      answering "true" without cause additionally obliges an
      ITSEncryptionExportComplianceCode we do not hold.

      Ticket 05 works App Store Connect's questionnaire and sets the value from
      its outcome. Blocking a release on an unanswered questionnaire is normal;
      shipping a wrong self-declaration is a compliance problem.
    -->
</dict>
</plist>
