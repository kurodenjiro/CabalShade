{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/**",
              "ui_kits/brand-surfaces/**",
              "ui_kits/mesh-console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Silkscreen|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Silkscreen, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|quiet|loud|info|success|alert)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'quiet' | 'loud' | 'info' | 'success' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|block|disabled|as|icon|iconAfter|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: tone, size, block, disabled, as, icon, iconAfter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|ghost|danger|signal)$/]",
        "message": "<Button> tone must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'signal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a|div)$/]",
        "message": "<Button> as must be one of 'button' | 'a' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterPortrait'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tint|label|basePath|key|ref|className|style|children)$/]",
        "message": "<CharacterPortrait> doesn't accept that prop. Declared props: name, size, tint, label, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterPortrait'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:oracle|monk|watcher|keeper|archivist|pilgrim|ghost|machine-priest)$/]",
        "message": "<CharacterPortrait> name must be one of 'oracle' | 'monk' | 'watcher' | 'keeper' | 'archivist' | 'pilgrim' | 'ghost' | 'machine-priest'."
      },
